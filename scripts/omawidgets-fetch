#!/usr/bin/env bash
#
# Fetches one URL with hard ceilings and writes it to a file.
#
# This exists because nothing inside the shell process can bound a response.
# Quickshell's XMLHttpRequest exposes no timeout, and its size can only be
# inspected once Qt has buffered it: with `responseType = "arraybuffer"` not
# until the body is complete, and even for text not until the first LOADING
# event, which on a fast producer already carried 1.5 MB against a 64 KB cap
# when measured. A check that runs after the memory has been taken is not a
# limit. curl can stop at the socket, so the fetching happens here.
#
# Four ceilings, none of them advisory:
#   --max-filesize  refuses a response whose declared length is over the cap
#   head -c         cuts the stream at the cap, killing curl with SIGPIPE, so an
#                   undeclared or chunked body stops at cap + 1
#   --max-time      bounds a server that sends slowly, or not at all
#   the size check  discards a file that reached the cap exactly, because a
#                   truncated answer is not a short one
#
# Usage: omawidgets-fetch <source> <destination> <max-bytes> [any|image|local-image]
#
# `local-image` copies a local file instead of fetching a URL. That exists
# because handing a local path straight to a QML Image is its own denial of
# service: Qt runs one image-reader thread per engine, the shell is one engine,
# and a path whose open() blocks — a FIFO with no writer — parks that thread
# for good, taking every other image in the shell with it. So a local cover is
# checked for being a regular file, read under a timeout, gated on the same
# magic bytes, and copied here; QML only ever points an Image at a file this
# script wrote.
#
# Nothing reaches a shell: the URL and the destination are arguments, both are
# validated here as well as by the caller, and `image` gates the result on the
# file's own magic bytes rather than on whatever Content-Type came with it.
#
# On where these URLs may point: a cover URL comes from a process on the user's
# own session bus, and the fetch runs as that same user. Refusing loopback or
# private addresses here would not be a privilege boundary — a process that can
# publish an MPRIS URL can already make the request itself. What matters is that
# the answer cannot cost this shell unbounded memory or time, and cannot become
# anything but a picture, which is what the ceilings and the magic check are
# for.
set -uo pipefail

PATH=/usr/bin:/bin
export PATH
LC_ALL=C
export LC_ALL

HARD_CAP=1048576
MAX_SECONDS=8
# Eight thousand a side is more than any album cover and well inside what a
# decoder will allocate for.
MAX_PIXELS=8192

source=${1:-}
out=${2:-}
cap=${3:-}
kind=${4:-any}

[[ -n $source && -n $out && -n $cap ]] || exit 2
[[ $kind == any || $kind == image || $kind == local-image ]] || exit 3
(( ${#source} <= 4096 )) || exit 3

if [[ $kind == local-image ]]; then
  # A path, not a URL. -f follows symlinks and is false for a FIFO, a
  # directory, a device or anything else that is not a regular file, which is
  # the class that can block on open.
  [[ $source == /* ]] || exit 3
  [[ -f $source && -r $source ]] || exit 10
else
  # http(s) only, no shell metacharacters, and short enough to be a URL.
  [[ $source =~ ^https?://[A-Za-z0-9][A-Za-z0-9._~:/?\#@!\&*+,\;=%-]*$ ]] || exit 3
  (( ${#source} <= 2048 )) || exit 3
fi

[[ $cap =~ ^[0-9]{1,8}$ ]] || exit 3
(( cap > 0 && cap <= HARD_CAP )) || exit 3

# Somewhere this user owns, and nowhere else.
runtime=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
[[ $out == "$runtime"/omawidgets/?* && $out != *..* && $out != */ ]] || exit 4

dir=$(dirname -- "$out")
# 0700 rather than whatever the umask says: the contents are this user's and
# nobody else's business, even inside a runtime directory that is already 0700.
mkdir -p -m 700 "$dir" || exit 4
# The prefix check above is lexical, so a symlinked path component would carry
# the write outside the runtime directory. Resolve it and check again.
real=$(realpath -m -- "$dir" 2>/dev/null) || exit 4
[[ $real == "$runtime"/omawidgets || $real == "$runtime"/omawidgets/* ]] || exit 4
# Fetched files accumulate one per track over a long session. They live in a
# tmpfs that is wiped at logout, but an hour is long enough for any of them.
find "$dir" -maxdepth 1 -type f \( -name '*.img' -o -name '.fetch.*' \) \
  -mmin +60 -delete 2>/dev/null
# And by count, for the same reason from the other direction: a player that
# rewrites its artwork URL in a loop would otherwise fill a tmpfs an hour at a
# time. Keep the newest eight of whatever this call is fetching.
prefix=$(basename -- "$out"); prefix=${prefix%%-*}
ls -1t "$dir/$prefix-"*.img 2>/dev/null | tail -n +8 | while IFS= read -r stale; do
  rm -f -- "$stale"
done

# mktemp rather than a name we compose: a predictable temporary in a directory
# another process of this user could reach is a symlink away from writing
# somewhere else entirely.
tmp=$(mktemp "$dir/.fetch.XXXXXXXX") || exit 4

# The transfer runs as a background job so it has a process group of its own,
# which is what makes it killable. A SIGTERM to this script that left curl
# running would mean two fetches overlapping, each still pulling up to the cap
# — and the caller cancels on every artwork change.
set -m
job=""
cleanup() {
  [[ -n $job ]] && kill -- -"$job" 2>/dev/null
  rm -f -- "$tmp"
}
trap cleanup EXIT

if [[ $kind == local-image ]]; then
  # Under a timeout as well as behind the -f test above: the file could have
  # been replaced between the two, and a read that blocks must not become this
  # script's problem either.
  { timeout "$MAX_SECONDS" head -c "$cap" -- "$source" > "$tmp" 2>/dev/null; } &
  job=$!
  wait "$job" || exit 5
else
  # --proto-redir as well as --proto: without it a redirect can leave http(s)
  # for a scheme curl would not have started with.
  {
    curl --silent --show-error --fail --location --max-redirs 2 \
      --proto '=http,https' --proto-redir '=http,https' \
      --max-time "$MAX_SECONDS" --max-filesize "$cap" \
      --output - -- "$source" 2>/dev/null | head -c "$cap" > "$tmp"
    exit "${PIPESTATUS[0]}"
  } &
  job=$!
  wait "$job" || exit 5
fi
job=""

size=$(stat -c %s -- "$tmp" 2>/dev/null || echo 0)
(( size > 0 )) || exit 6
(( size < cap )) || exit 7

if [[ $kind == image || $kind == local-image ]]; then
  header=$(head -c 32 -- "$tmp" | od -An -tx1 -v | tr -d ' \n')
  # Enough bytes to carry a header at all. The smallest real file in any of
  # these formats is comfortably over 32 bytes, and a "PNG" that is only a
  # signature has no dimensions to check — it is a magic number, not an image.
  (( ${#header} == 64 )) || exit 9
  case $header in
    89504e470d0a1a0a*) ;;                      # PNG
    ffd8ff*) ;;                                # JPEG
    474946383*) ;;                             # GIF87a / GIF89a
    424d*) ;;                                  # BMP
    52494646????????57454250*) ;;              # RIFF....WEBP
    *) exit 9 ;;
  esac

  # A file inside its byte budget can still declare an enormous canvas, and a
  # decoder asked for one allocates for it. Qt has a 256 MB ceiling of its own,
  # but that is Qt's guarantee rather than this plugin's, and it is settable.
  # The dimensions live at a fixed offset in three of these five formats.
  hex_at() { echo "${header:$(( $1 * 2 )):$(( $2 * 2 ))}"; }
  width=0; height=0
  case $header in
    89504e470d0a1a0a*)                         # PNG: IHDR, big-endian, at 16
      width=$(( 16#$(hex_at 16 4) )); height=$(( 16#$(hex_at 20 4) )) ;;
    474946383*)                                # GIF: little-endian, at 6
      width=$(( 16#$(hex_at 7 1)$(hex_at 6 1) )); height=$(( 16#$(hex_at 9 1)$(hex_at 8 1) )) ;;
    424d*)                                     # BMP: little-endian, at 18
      width=$(( 16#$(hex_at 21 1)$(hex_at 20 1)$(hex_at 19 1)$(hex_at 18 1) ))
      height=$(( 16#$(hex_at 25 1)$(hex_at 24 1)$(hex_at 23 1)$(hex_at 22 1) )) ;;
  esac
  (( width <= MAX_PIXELS && height <= MAX_PIXELS )) || exit 11
fi

# -T so a destination that happens to be a directory is an error rather than a
# file quietly moved inside it, which would return 0 with nothing at $out.
mv -fT -- "$tmp" "$out" || exit 8
trap - EXIT
